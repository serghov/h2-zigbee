{
  "name": "ebpf-compiler-editor",
  "private": true,
  "type": "module",
  "description": "CodeMirror 6 bundle for the Home Assistant panel (custom_components/h2_rules/frontend/vendor/editor.js)",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --format=esm --minify --target=es2020 --legal-comments=eof --outfile=../../custom_components/h2_rules/frontend/vendor/editor.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": { "esbuild": "0.28.2" },
  "overrides": { "@codemirror/lint": "6.9.7", "@codemirror/view": "6.43.15", "@codemirror/state": "6.7.6" }
}
